# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/clientsuite_music?schema=public"

# Authentication & Security
JWT_ACCESS_SECRET=clientsuite_access_super_secret_key_change_in_production
JWT_REFRESH_SECRET=clientsuite_refresh_super_secret_key_change_in_production
JWT_EXPIRES_IN=1d

# Storage Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=200

# Audio Preview Settings
DEFAULT_PREVIEW_DURATION_SECONDS=15
